# ==========================================================
# FoodAI Backend - Plantilla de Variables de Entorno
# Nunca subas credenciales reales ni archivos .env a Git.
# ==========================================================

# Puerto HTTP (Render inyecta PORT automáticamente en producción)
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Clave privada de Google Gemini (SOLO servidor; nunca exponer en frontend)
GEMINI_API_KEY=

# URL base del proyecto Supabase (obligatoria para verificar firmas JWT vía JWKS)
# Ejemplo: https://<project-ref>.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Audiencia esperada en los access tokens de usuarios autenticados en Supabase
SUPABASE_JWT_AUDIENCE=authenticated

# Secreto HS256 legado (OPCIONAL: dejar vacío si el proyecto Supabase firma con claves asimétricas ES256/RS256 vía JWKS)
# Nunca coloques aquí la service_role key.
SUPABASE_JWT_SECRET=

# Lista blanca de orígenes web permitidos por CORS (separados por comas, sin comodín *)
# En producción solo se aceptan orígenes HTTPS explícitos. El APK nativo Android no envía Origin.
CORS_ALLOWED_ORIGINS=

# Número exacto de saltos de proxy inverso confiables (entero 0..5; nunca "true")
# Por defecto: 1 en production (Render reverse proxy) y 0 en development/test
TRUST_PROXY_HOPS=

# Límites de protección para endpoints de IA (Gemini)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30
AI_USER_RATE_LIMIT_MAX=20
AI_MAX_CONCURRENT_REQUESTS=10
